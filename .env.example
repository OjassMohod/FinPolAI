# Optional: leave all three blank for fully functional deterministic Workflow Mode.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Chat completions base URL should end in /v1 (or provider's equivalent API base).
# Defaults to semantic retrieval; falls back visibly to TF-IDF if unavailable.
RAG_MODE=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 1 uses only a model already downloaded; 0 permits first-run HTTPS download.
EMBEDDING_LOCAL_ONLY=0
POLICYGUARD_DATA_DIR=.runtime
# Synthetic demo use only. No real customer or banking data.
