        "SG",
        "US",
        "GB",
        "DE",
        "AU",
        "CA",
        "AE",
        "JP"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "RESTRICT-RECIPIENT_COUNTRY",
    "policy_reference": "POLICY-COUNTRY-03",
    "description": "Country must not be restricted",
    "assertion": {
      "field": "recipient_country",
      "operator": "not_in",
      "value": [
        "KP",
        "IR",
        "SY"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "PURPOSE",
    "policy_reference": "POLICY-BUSINESS-05",
    "description": "Payment purpose must be supported",
    "assertion": {
      "field": "purpose",
      "operator": "in",
      "value": [
        "personal",
        "family_support",
        "tuition",
        "medical",
        "business",
        "investment"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "BUSINESS-PURPOSE",
    "policy_reference": "POLICY-BUSINESS-05",
    "description": "Business customers must use business purpose",
    "assertion": {
      "field": "purpose",
      "operator": "eq",
      "value": "business"
    },
    "action": "flag",
    "when": {
      "field": "customer_type",
      "operator": "eq",
      "value": "business"
    }
  },
  {
    "rule_id": "BUSINESS-INVOICE",
    "policy_reference": "POLICY-DOCS-04",
    "description": "Business payments require an invoice",
    "assertion": {
      "field": "documents",
      "operator": "contains_all",
      "value": [
        "invoice"
      ]
    },
    "action": "flag",
    "when": {
      "field": "customer_type",
      "operator": "eq",
      "value": "business"
    }
  },
  {
    "rule_id": "CAP-INR",
    "policy_reference": "POLICY-TRANSFER-01",
    "description": "Transfer must be at most 1,000,000 INR",
    "assertion": {
      "field": "amount",
      "operator": "lte",
      "value": 1000000
    },
    "action": "flag",
    "when": {
      "field": "currency",
      "operator": "eq",
      "value": "INR"
    }
  },
  {
    "rule_id": "REVIEW-INR",
    "policy_reference": "POLICY-REVIEW-06",
    "description": "Amounts above 500,000 INR need manual review",
    "assertion": {
      "field": "amount",
      "operator": "lte",
      "value": 500000
    },
    "action": "manual_review",
    "when": {
      "field": "currency",
      "operator": "eq",
      "value": "INR"
    }
  },
  {
    "rule_id": "DOCS-INR",
    "policy_reference": "POLICY-DOCS-04",
    "description": "Above 200,000 INR, provide source of funds",
    "assertion": {
      "field": "documents",
      "operator": "contains_all",
      "value": [
        "source_of_funds"
      ]
    },
    "action": "flag",
    "when": {
      "all": [
        {
          "field": "currency",
          "operator": "eq",
          "value": "INR"
        },
        {
          "field": "amount",
          "operator": "gt",
          "value": 200000
        }
      ]
    },
    "exception": {
      "all": [
        {
          "field": "purpose",
          "operator": "eq",
          "value": "tuition"
        },
        {
          "field": "documents",
          "operator": "contains_all",
          "value": [
            "scholarship_letter",
            "enrollment_letter"
          ]
        }
      ]
    },
    "exception_reference": "POLICY-EXCEPTION-07"
  },
