  {
    "rule_id": "CURRENCY",
    "policy_reference": "POLICY-TRANSFER-01",
    "description": "Use a supported currency",
    "assertion": {
      "field": "currency",
      "operator": "in",
      "value": [
        "INR",
        "USD",
        "EUR",
        "SGD",
        "GBP"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "CORRIDOR-SENDER_COUNTRY",
    "policy_reference": "POLICY-COUNTRY-03",
    "description": "Country must be supported",
    "assertion": {
      "field": "sender_country",
      "operator": "in",
      "value": [
        "IN",
        "SG",
        "US",
        "GB",
        "DE",
        "AU",
        "CA",
        "AE",
        "JP"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "RESTRICT-SENDER_COUNTRY",
    "policy_reference": "POLICY-COUNTRY-03",
    "description": "Country must not be restricted",
    "assertion": {
      "field": "sender_country",
      "operator": "not_in",
      "value": [
        "KP",
        "IR",
        "SY"
      ]
    },
    "action": "flag"
  },
  {
    "rule_id": "CORRIDOR-RECIPIENT_COUNTRY",
    "policy_reference": "POLICY-COUNTRY-03",
    "description": "Country must be supported",
    "assertion": {
